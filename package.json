{
  "name": "spira-test-case-importer",
  "version": "0.1.0",
  "description": "LLM-assisted test case importer for Spira",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "spira-import": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
