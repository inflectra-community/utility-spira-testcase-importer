# Spira Instance (required for @live integration tests)
SPIRA_URL=https://your-instance.spiraservice.net/api/v7.0
SPIRA_USERNAME=your-username
SPIRA_API_KEY=your-api-key
SPIRA_PROJECT_ID=1

# LLM Provider (required for @live LLM tests)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-...

# AWS Bedrock (alternative to LLM_API_KEY when using Bedrock)
# AWS_REGION=us-east-1
# AWS credentials via standard AWS SDK chain (env vars, ~/.aws/credentials, etc.)
