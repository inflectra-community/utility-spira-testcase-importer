# Spira Instance
SPIRA_URL=https://your-instance.spiraservice.net
SPIRA_USERNAME=your-username
SPIRA_API_KEY={YOUR-API-KEY-GUID}
SPIRA_PROJECT_ID=1

# LLM Provider (bedrock, openai, or anthropic)
LLM_PROVIDER=bedrock
LLM_MODEL=amazon.nova-lite-v1:0

# AWS Bedrock credentials (when using bedrock provider)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# OpenAI / Anthropic (when using those providers)
# LLM_API_KEY=sk-...

# Import settings
SOURCE_FILE=./your-spreadsheet.xlsx
ROOT_FOLDER=
